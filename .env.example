# FadeReach — Environment Variables
# Copy to .env and fill all values before running
# NEVER commit .env to git

 # ── Infrastructure ─────────────────────────────────────
VPS_IP=YOUR_CONTABO_IP_HERE
APP_URL=https://fadereach.app
DOMAIN=fadereach.app
SENDING_DOMAIN_1=fr-send1.com
SENDING_DOMAIN_2=fr-send2.com

# ── Database ───────────────────────────────────────────
POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_base64_24
POSTGRES_RUNTIME_PASSWORD=GENERATE_WITH_openssl_rand_base64_24

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_48

# ── Listmonk ───────────────────────────────────────────
LISTMONK_ADMIN_PASSWORD=GENERATE_WITH_openssl_rand_base64_16

# ── n8n ────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_base64_32

# ── AI APIs ────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
KIMI_API_KEY=...
GROK_API_KEY=...
# Ollama runs locally — no key needed

# ── Lead Generation ────────────────────────────────────
HUNTER_API_KEY=...
ZEROBOUNCE_API_KEY=...
APIFY_TOKEN=...

# ── Billing ────────────────────────────────────────────
LEMONSQUEEZY_STORE_ID=247127
LEMONSQUEEZY_API_KEY=...
LEMONSQUEEZY_WEBHOOK_SECRET=...

PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...

# ── Monitoring ─────────────────────────────────────────
SENTRY_DSN=...
UPTIMEROBOT_API_KEY=...

# Fernet key for provider credentials: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=generate-a-unique-fernet-key

# HMAC secret shared only with trusted TADS/SDEA signal producers
SIGNAL_INGEST_SECRET=change-me
