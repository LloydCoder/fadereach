# FadeReach — Environment Variables
# Copy to .env and fill all values before running.
# NEVER commit .env to git.

# Infrastructure
APP_URL=https://fadereach.app
DOMAIN=fadereach.app
VPS_IP=YOUR_VPS_IP

# Database
POSTGRES_PASSWORD=GENERATE_A_RANDOM_32_CHAR_SECRET
POSTGRES_RUNTIME_PASSWORD=GENERATE_A_RANDOM_32_CHAR_SECRET
POSTGRES_WORKER_PASSWORD=GENERATE_A_RANDOM_32_CHAR_SECRET
N8N_DB_PASSWORD=GENERATE_A_RANDOM_32_CHAR_SECRET
LISTMONK_DB_PASSWORD=GENERATE_A_RANDOM_32_CHAR_SECRET

# Auth / encryption
JWT_SECRET=GENERATE_A_RANDOM_64_CHAR_SECRET
CREDENTIAL_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
UNSUBSCRIBE_SECRET=GENERATE_A_RANDOM_64_CHAR_SECRET
SIGNAL_INGEST_SECRET=GENERATE_A_RANDOM_32_CHAR_SECRET

# Listmonk
LISTMONK_ADMIN_PASSWORD=GENERATE_A_RANDOM_32_CHAR_SECRET

# n8n
N8N_ENCRYPTION_KEY=GENERATE_A_RANDOM_64_CHAR_SECRET

# AI APIs
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GROK_API_KEY=

# Lead generation
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
APIFY_TOKEN=

# Billing
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PADDLE_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
UPTIMEROBOT_API_KEY=


# ── Security controls ───────────────────────────────────
# Required in production. Comma-separated CIDRs allowed to call /api/admin.
ADMIN_ALLOWED_IP_CIDRS=
# Maximum accepted webhook body size.
MAX_WEBHOOK_BODY_BYTES=1048576

# Optional bearer token for /internal/metrics
METRICS_TOKEN=
